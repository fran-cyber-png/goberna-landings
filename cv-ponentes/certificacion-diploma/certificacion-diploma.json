    "custom_css": "selector .ak-cert-in { --width: 100%; width: 100%; max-width: 619px; }\n/* color de acento plano */\nselector .ak-oro-text .elementor-heading-title, selector .ak-cert-title .ak-g { background-image: linear-gradient(#8C1A17, #8C1A17); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\nselector .ak-card { border-color: transparent !important; background: linear-gradient(#EBEFF2, #EBEFF2) padding-box, linear-gradient(#8C1A17, #8C1A17) border-box !important; }\nselector .ak-cert-btn .elementor-button { border-image: linear-gradient(#8C1A17, #8C1A17) 1 !important; }\nselector .ak-cert-btn .elementor-button-text, selector .ak-cert-btn .elementor-button-icon i { background-image: linear-gradient(#8C1A17, #8C1A17); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }\nselector .ak-cert-btn .elementor-button:hover { background-image: linear-gradient(#8C1A17, #8C1A17) !important; }\nselector .ak-cert-btn .elementor-button:hover .elementor-button-text, selector .ak-cert-btn .elementor-button:hover .elementor-button-icon i { -webkit-text-fill-color: #060606; }\nselector .ak-medal img { display: block; width: 32px; height: auto; }\nselector .ak-cert-title .elementor-heading-title { white-space: nowrap; }\nselector .ak-card { --width: 100%; width: 100%; }\nselector .ak-card-body { --width: auto; width: auto; flex: 1 1 auto; min-width: 0; }\nselector .ak-cert-btn .elementor-button { width: auto; min-width: 340px; height: 68px; display: inline-flex; align-items: center; justify-content: center; gap: 16px; padding: 0 36px; }\nselector .elementor-widget-text-editor p { margin: 0; }\n@media (max-width: 1366px) {\n  selector .ak-cert-btn .elementor-button { min-width: 280px; height: 58px; padding: 0 30px; }\n}\nselector .ak-mb { display: none; }\n@media (max-width: 767px) {\n  selector .ak-mb { display: inline; }\n  selector .ak-dk { display: none; }\n  selector .ak-cert-title .elementor-heading-title { white-space: normal; }\n  selector .ak-cert-btn .elementor-button { min-width: 220px; height: 44px; padding: 0 22px; gap: 12px; }\n}\n/* Pantalla completa (desktop y laptop): la sección mide lo que queda bajo el header fijo y todo el bloque\n   de la derecha se escala en proporción con --u (1 px del diseño original). Mismos espacios y colores, solo más chico si la pantalla es baja. */\n@media (min-width: 1025px) {\n  selector { min-height: calc(100vh - 90px) !important; --u: min(1px, calc((100vh - 90px) / 960)); }\n  /* el panel de la imagen nunca es más ancho que 1.1 veces su alto: así el certificado no se recorta */\n  selector > .ak-cert-img { --width: 55%; width: 55% !important; background-position: 50% 52.5% !important; }\n  selector > .ak-cert-txt { --width: auto; width: auto !important; flex: 1 1 0 !important; align-items: flex-start !important; }\n  selector > .ak-cert-txt { padding: calc(var(--u) * 52) calc(var(--u) * 24) calc(var(--u) * 38) calc(max(50vw - var(--u) * 619, var(--u) * 120) / 4) !important; }\n  selector .ak-cert-in { max-width: calc(var(--u) * 619); }\n  selector .ak-oro-text .elementor-heading-title { font-size: calc(var(--u) * 20) !important; letter-spacing: calc(var(--u) * 2) !important; }\n  selector .ak-cert-title { margin-top: calc(var(--u) * 31) !important; }\n  selector .ak-cert-title .elementor-heading-title { font-size: calc(var(--u) * 50) !important; }\n  selector .ak-cert-p { margin-top: calc(var(--u) * 28) !important; }\n  selector .ak-cert-p, selector .ak-cert-p p { font-size: calc(var(--u) * 20) !important; }\n  selector .ak-card { padding: calc(var(--u) * 30) calc(var(--u) * 24) calc(var(--u) * 30) calc(var(--u) * 24) !important; gap: calc(var(--u) * 18) !important; }\n  selector .ak-cert-in > .ak-card:nth-of-type(1), selector .ak-cert-p + .ak-card { margin-top: calc(var(--u) * 32) !important; }\n  selector .ak-card + .ak-card { margin-top: calc(var(--u) * 21) !important; }\n  selector .ak-medal { padding-top: calc(var(--u) * 4) !important; }\n  selector .ak-medal img { width: calc(var(--u) * 32) !important; }\n  selector .ak-card-body { gap: calc(var(--u) * 6) !important; }\n  selector .ak-card-body .elementor-heading-title { font-size: calc(var(--u) * 20) !important; }\n  selector .ak-card-body .elementor-widget-text-editor, selector .ak-card-body .elementor-widget-text-editor p { font-size: calc(var(--u) * 20) !important; }\n  selector .ak-cert-btn { margin-top: calc(var(--u) * 28) !important; }\n  selector .ak-cert-btn .elementor-button { width: auto !important; min-width: calc(var(--u) * 340) !important; height: calc(var(--u) * 68) !important; padding: 0 calc(var(--u) * 36) !important; gap: calc(var(--u) * 16) !important; font-size: calc(var(--u) * 16) !important; letter-spacing: calc(var(--u) * 1.44) !important; }\n}\n@media (min-width: 1025px) and (max-width: 1366px) {\n  selector { min-height: calc(100vh - 80px) !important; --u: min(1px, calc((100vh - 80px) / 791)); }\n  selector > .ak-cert-img { --width: 55%; width: 55% !important; background-position: 50% 52.5% !important; }\n  selector > .ak-cert-txt { padding: calc(var(--u) * 56) calc(var(--u) * 24) calc(var(--u) * 56) calc(max(50vw - var(--u) * 619, var(--u) * 96) / 4) !important; }\n  selector .ak-cert-in { max-width: calc(var(--u) * 619); }\n  selector .ak-oro-text .elementor-heading-title { font-size: calc(var(--u) * 16) !important; letter-spacing: calc(var(--u) * 1.8) !important; }\n  selector .ak-cert-title { margin-top: calc(var(--u) * 24) !important; }\n  selector .ak-cert-title .elementor-heading-title { font-size: calc(var(--u) * 42) !important; }\n  selector .ak-cert-p { margin-top: calc(var(--u) * 22) !important; }\n  selector .ak-cert-p, selector .ak-cert-p p { font-size: calc(var(--u) * 17) !important; }\n  selector .ak-card { padding: calc(var(--u) * 26) calc(var(--u) * 20) calc(var(--u) * 24) calc(var(--u) * 20) !important; gap: calc(var(--u) * 18) !important; }\n  selector .ak-cert-in > 