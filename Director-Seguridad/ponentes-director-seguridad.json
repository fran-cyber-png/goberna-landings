vents: none; z-index: 0;\n  background: linear-gradient(to bottom, rgba(6,6,6,0) 44%, rgba(6,6,6,.82) 64%, rgba(6,6,6,.94) 76%, #060606 92%); }\nselector .ak-doc-card > .e-con, selector .ak-doc-card > .elementor-element { position: relative; z-index: 1; }\n/* posición fija como el Figma: el nombre empieza al 67% de la tarjeta y \"Ver trayectoria\" queda abajo */\nselector .ak-doc-card > .e-con.ak-doc-body { position: absolute !important; top: 67%; bottom: 18px; left: 16px; right: 16px; width: auto !important; z-index: 1;\n  display: flex !important; flex-direction: column; justify-content: flex-start; align-items: flex-start; }\nselector .ak-doc-body .ak-doc-link { margin-top: auto !important; }\nselector .ak-doc-flag img { display: block; }\nselector .ak-doc-link .elementor-button { padding: 0 0 7px; border-bottom: 1px solid #FFBB03; border-radius: 0; }\n/* flechas */\nselector .ak-doc-carousel .elementor-swiper-button { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 17px; top: calc(50% - 21px) !important; transform: translateY(-50%); margin: 0; z-index: 3; cursor: pointer; transition: background .2s, color .2s; }\nselector .ak-doc-carousel .elementor-swiper-button svg { width: 17px; height: 17px; }\nselector .ak-doc-carousel .elementor-swiper-button-prev { left: -166px !important; right: auto !important; background: transparent; border: 1px solid transparent; background: linear-gradient(#090909, #090909) padding-box, linear-gradient(#FFBB03, #FFBB03) border-box; color: #FFBB03; fill: #FFBB03; }\nselector .ak-doc-carousel .elementor-swiper-button-next { right: -166px !important; left: auto !important; background: linear-gradient(#FFBB03, #FFBB03); border: 1px solid #FFBB03; color: #060606; fill: #060606; }\nselector .ak-doc-carousel .elementor-swiper-button-prev:hover { background: #F3F5F7; color: #15262F; fill: #15262F; }\nselector .ak-doc-carousel .elementor-swiper-button-next:hover { backgro