          "custom_css": "/* --- contador --- */\r\nselector .elementor-accordion,\r\nselector .e-n-accordion {\r\n  counter-reset: faq;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0;\r\n}\r\n\r\n/* --- item: sin tarjeta, separado por línea divisoria --- */\r\nselector .elementor-accordion-item,\r\nselector .e-n-accordion-item {\r\n  counter-increment: faq;\r\n  background: transparent;\r\n  border: none;\r\n  border-bottom: 1px solid #E4E7EE;\r\n  border-radius: 0;\r\n  box-shadow: none;\r\n  overflow: hidden;\r\n}\r\n\r\nselector .elementor-accordion-item:last-child,\r\nselector .e-n-accordion-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n/* --- la cabecera --- */\r\nselector .elementor-tab-title,\r\nselector .e-n-accordion-item-title {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0;\r\n  min-height: 68px;\r\n  padding: 0 8px;\r\n  background: transparent;\r\n  border: none;\r\n  list-style: none;\r\n  cursor: pointer;\r\n}\r\n\r\nselector .e-n-accordion-item-title::marker,\r\nselector .e-n-accordion-item-title::-webkit-details-marker {\r\n  display: none;\r\n  content: \"\";\r\n}\r\n\r\n/* --- el número dorado + línea divisoria --- */\r\nselector .elementor-tab-title::before,\r\nselector .e-n-accordion-item-title::before {\r\n  content: counter(faq, decimal-leading-zero);\r\n  order: 1;\r\n  flex: 0 0 auto;\r\n  padding-right: 26px;\r\n  margin-right: 26px;\r\n  border-right: 1px solid #C7CCD8;\r\n  font: normal normal 800 26px/1 Inter, sans-serif;\r\n  color: #D5A752 !important;\r\n}\r\n\r\n/* --- el texto de la pregunta --- */\r\nselector .elementor-accordion-title,\r\nselector .e-n-accordion-item-title-header {\r\n  order: 2;\r\n  flex: 1 1 auto;\r\n}\r\n\r\nselector .elementor-accordion-title,\r\nselector .e-n-accordion-item-title-text {\r\n  font: normal normal 600 17px/24px Inter, sans-serif;\r\n  letter-spacing: 0;\r\n  color: #0B142D;\r\n  text-align: left;\r\n}\r\n\r\n/* --- el + / - en círculo dorado a la derecha --- *